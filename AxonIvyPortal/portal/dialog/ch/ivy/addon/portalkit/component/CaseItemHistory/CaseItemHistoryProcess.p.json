    }, {
      "id" : "f26",
      "type" : "Script",
      "name" : [
        "Create histories",
        "from tasks and notes"
      ],
      "config" : {
        "output" : {
          "code" : [
            "import org.primefaces.PrimeFaces;",
            "import ch.ivy.addon.portalkit.util.CaseUtils;",
            "import ch.ivy.addon.portalkit.service.HistoryService;",
            "import ch.ivyteam.ivy.workflow.ICase;",
            "import ch.ivyteam.ivy.workflow.ITask;",
            "import ch.ivyteam.ivy.workflow.TaskState;",
            "import java.util.ArrayList;",
            "",
            "in.historiesLoadFailed = false;",
            "try {",
            "  List<ITask> finishedTasks = new ArrayList();",
            "  for (ITask task : in.caze.tasks().all()) {",
            "    if (task.getState() == TaskState.DONE",
            "    || task.getState() == TaskState.DESTROYED) {",
            "      finishedTasks.add(task);",
            "    }",
            "  }",
            "",
            "  long selectedCaseId = in.caze.getId();",
            "  List<ICase> cases = new ArrayList();",
            "  cases.add(in.caze);",
            "  cases.addAll(CaseUtils.findSubCasesByBusinessCaseId(selectedCaseId));",
            "",
            "  HistoryService historyService = new HistoryService();",
            "  in.histories = historyService.getCaseHistories(selectedCaseId, finishedTasks, cases, !in.showSystemTasksChkbox, !in.showSystemNotesChkbox);",
            "} catch (Exception e) {",
            "  ivy.log.error(\"Cannot load case histories\", e);",
            "  in.histories = new ArrayList();",
            "  in.historiesLoadFailed = true;",
            "}",
            "in.historiesLoaded = true;",
            "// Responsive table",
            "PrimeFaces.current().executeScript(\"ResponsiveTable.init(':case-histories')\");"
          ]
        },
        "sudo" : true
      },
      "visual" : {
        "at" : { "x" : 416, "y" : 192 },
        "size" : { "width" : 144 }
      },
      "connect" : [
