    }, {
      "id" : "f8",
      "type" : "Script",
      "name" : [
        "Read Portal settings",
        "and default values of",
        "system entries"
      ],
      "config" : {
        "output" : {
          "code" : [
            "import jakarta.faces.context.FacesContext;",
            "import ch.ivy.addon.portalkit.enums.GlobalVariable;",
            "import ch.ivy.addon.portalkit.util.PermissionUtils;",
            "import ch.ivy.addon.portalkit.service.GlobalSettingService;",
            "",
            "GlobalSettingService service = new GlobalSettingService();",
            "",
            "out.showRelatedCaseInfoCheckbox = in.caze.isBusinessCase() && !service.findGlobalSettingValueAsBoolean(GlobalVariable.HIDE_RELATED_CASE_INFO_FROM_HISTORY);",
            "boolean isAdmin = PermissionUtils.isSessionUserHasAdminRole();",
            "boolean isUserHasPermissionNoteReadAllCaseTaskDetails = PermissionUtils.checkNoteReadAllCaseTaskDetailsPermission();",
            "out.showSystemNotes = isUserHasPermissionNoteReadAllCaseTaskDetails;",
            "",
            "out.showSystemTasks = isAdmin ? !service.findGlobalSettingValueAsBoolean(GlobalVariable.HIDE_SYSTEM_TASKS_FROM_HISTORY_ADMINISTRATOR)",
            "                              : !service.findGlobalSettingValueAsBoolean(GlobalVariable.HIDE_SYSTEM_TASKS_FROM_HISTORY);",
            "",
            "out.showSystemNotesChkbox = out.showSystemNotes && service.isCheckSystemNotesByDefault();",
            "out.showSystemTasksChkbox = out.showSystemTasks && service.isCheckSystemTasksByDefault();",
            "",
            "out.showRelatedCaseInfo= isAdmin && out.showRelatedCaseInfoCheckbox;",
            "",
            "if (!FacesContext.getCurrentInstance().getPartialViewContext().isAjaxRequest()) {",
            "  out.historiesLoaded = false;",
            "}"
          ]
        }
      },
      "visual" : {
