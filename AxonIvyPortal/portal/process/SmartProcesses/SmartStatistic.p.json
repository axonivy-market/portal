{
  "$schema" : "https://json-schema.axonivy.com/14.0/project/process.json",
  "id" : "1A0C218A883F7EC5",
  "config" : {
    "data" : "com.axonivy.portal.SmartStatisticData"
  },
  "elements" : [ {
      "id" : "f0",
      "type" : "RequestStart",
      "name" : "start(String,String)",
      "config" : {
        "signature" : "smartStatistic",
        "input" : {
          "params" : [
            { "name" : "id", "type" : "String", "desc" : "Id of an existing custom chart to refine. Keep empty to start a new one." },
            { "name" : "callbackDashboardId", "type" : "String", "desc" : "Dashboard to return to after saving. Keep empty to return to the Portal home page." }
          ],
          "map" : {
            "out.callbackDashboardId" : "param.callbackDashboardId",
            "out.id" : "param.id"
          }
        },
        "request" : {
          "name" : "Smart Statistic",
          "customFields" : [
            { "name" : "isDashboardProcess", "value" : "true" }
          ]
        },
        "case" : {
          "customFields" : [
            { "name" : "embedInFrame", "type" : "STRING", "value" : "\"false\"" }
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 96, "y" : 64 }
      },
      "connect" : [
        { "id" : "f2", "to" : "f3" }
      ]
    }, {
      "id" : "f1",
      "type" : "TaskEnd",
      "visual" : {
        "at" : { "x" : 352, "y" : 64 }
      }
    }, {
      "id" : "f3",
      "type" : "DialogCall",
      "config" : {
        "dialog" : "com.axonivy.portal.smart.statistic.SmartStatisticPage:start(String,String)",
        "call" : {
          "map" : {
            "param.callbackDashboardId" : "in.callbackDashboardId",
            "param.id" : "in.id"
          }
        }
      },
      "visual" : {
        "at" : { "x" : 224, "y" : 64 }
      },
      "connect" : [
        { "id" : "f4", "to" : "f1", "color" : "default" }
      ]
    } ]
}