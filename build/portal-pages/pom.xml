<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.axonivy.portal</groupId>
  <artifactId>portal-pages</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <properties>
    <portal12.version>12.0.18.1</portal12.version>
    <portal14.version>14.0.0</portal14.version>
    <portal.guide.url>https://maven.axonivy.com/com/axonivy/portal/portal-guide</portal.guide.url>
    <pages.directory>${project.build.directory}/portal</pages.directory>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <directory>${project.basedir}/../../target/portal-pages</directory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>unpack-released-documentation</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/archives" />
                <!-- Fetch ZIPs directly: older published POMs have unresolved ${revision} parents. -->
                <get src="${portal.guide.url}/${portal12.version}/portal-guide-${portal12.version}.zip"
                  dest="${project.build.directory}/archives/portal-guide-${portal12.version}.zip" />
                <get src="${portal.guide.url}/${portal14.version}/portal-guide-${portal14.version}.zip"
                  dest="${project.build.directory}/archives/portal-guide-${portal14.version}.zip" />
                <unzip src="${project.build.directory}/archives/portal-guide-${portal12.version}.zip"
                  dest="${pages.directory}/release/12.0" />
                <unzip src="${project.build.directory}/archives/portal-guide-${portal14.version}.zip"
                  dest="${pages.directory}/release/14.0" />
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>write-release-manifest</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${pages.directory}</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}</directory>
                  <filtering>true</filtering>
                  <includes>
                    <include>versions.json</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>dev-documentation</id>
      <activation>
        <property>
          <name>dev.archive</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>unpack-dev-documentation</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <unzip src="${dev.archive}" dest="${pages.directory}/snapshot/dev" />
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
