<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven credentials for GitHub Packages (used by Jenkins).
  Values come from environment variables; no secret is stored in this file.
  Jenkins must export GITHUB_ACTOR (GitHub login of the token owner) and GITHUB_TOKEN.
  The server id "github" must match -DrepositoryId=github in the deploy command.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>github</id>
      <username>wawa-axonivy</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
  </servers>
</settings>
