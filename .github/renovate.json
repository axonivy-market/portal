{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>axonivy-market/renovate-config"
    ],
    "baseBranchPatterns": [
        "master",
        "release/14.0",
        "release/12.0"
    ],
    "maven": {
        "fileMatch": [
            "(^|/|\\\\)pom\.xml$",
            "(^|/|\\\\)customized_pom\.xml$",
            "(^|/|\\\\)document_screenshot_pom\.xml$",
            "(^|/|\\\\)deployment-pom\.xml$"
        ]
    },
    "packageRules": [
        {
            "description": "Disable major and replacement upgrades for release/14.0 and release/12.0",
            "matchBaseBranches": [
                "release/14.0",
                "release/12.0"
            ],
            "matchUpdateTypes": [
                "major",
                "replacement"
            ],
            "enabled": false
        },
        {
            "description": "Automerge only on master",
            "matchBaseBranches": [
                "master"
            ],
            "automerge": true
        },
        {
            "description": "Disable automerge on release/14.0 and release/12.0",
            "matchBaseBranches": [
                "release/14.0",
                "release/12.0"
            ],
            "automerge": false
        }
    ]
}
